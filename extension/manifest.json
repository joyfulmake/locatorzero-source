{
  "manifest_version": 3,
  "name": "LocatorZero Tabs",
  "version": "0.1.0",
  "description": "Lets the LocatorZero desktop app find your open tabs. Talks only to LocatorZero on this computer, never to the internet. Private windows are never shared.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "icons": { "128": "icon-128.png" },
  "browser_specific_settings": { "gecko": { "id": "tabs@locatorzero.dev", "strict_min_version": "121.0" } }
}
